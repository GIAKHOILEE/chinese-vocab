# Kết nối PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/chinese_vocab_db?schema=public"

# Khóa bí mật JWT (đổi sang chuỗi ngẫu nhiên dài khi deploy production)
JWT_SECRET="change-this-to-a-long-random-secret"

# Cổng chạy Backend NestJS
PORT=3002

# Danh sách Origin Frontend được phép gọi API (nhiều domain cách nhau bằng dấu phẩy, hoặc * khi dev)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
