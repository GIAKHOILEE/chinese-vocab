# Môi trường chạy: development | production
NODE_ENV="development"

# Kết nối PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/chinese_vocab_db?schema=public"

# Khóa bí mật JWT (bắt buộc đổi sang chuỗi ngẫu nhiên dài >= 24 ký tự khi deploy production)
JWT_SECRET="change-this-to-a-long-random-secret-at-least-24-chars"
JWT_EXPIRES_IN="7d"

# Cổng chạy Backend NestJS
PORT=3002

# Danh sách Origin Frontend được phép gọi API (nhiều domain cách nhau bằng dấu phẩy, ví dụ: https://app.example.com)
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
