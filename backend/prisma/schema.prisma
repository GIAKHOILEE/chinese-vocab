// Prisma Schema cho Chinese Writing Practice
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Bảng lưu trữ từ vựng của người dùng
model Vocabulary {
  id           String         @id @default(uuid())
  word         String         // Từ tiếng Trung (Ví dụ: 学习)
  meaning      String         // Nghĩa tiếng Việt (Ví dụ: học)
  pinyin       String?        // Phiên âm Pinyin (Ví dụ: xuéxí)
  partOfSpeech String         @default("") // Từ loại (Ví dụ: Động từ, Danh từ, Tính từ...)
  level        String?        // Cấp độ (Ví dụ: HSK1, HSK2, Beginner)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  progress     VocabProgress?

  @@unique([word, partOfSpeech])
  @@index([word])
}

// Tiến độ SRS & ghi chú AI cho từng từ vựng
model VocabProgress {
  id              String     @id @default(uuid())
  vocabularyId    String     @unique
  vocabulary      Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  status          String     @default("new") // new | learning | review | mastered
  srsLevel        Int        @default(0)
  intervalDays    Float      @default(0)
  easeFactor      Float      @default(2.5)
  nextReviewAt    DateTime   @default(now())
  lastReviewedAt  DateTime?
  reviewCount     Int        @default(0)
  correctCount    Int        @default(0)
  wrongCount      Int        @default(0)
  aiMnemonic      String?    // Mẹo nhớ sâu / phân tích bộ thủ do AI tạo
  aiExamples      Json?      // Các câu ví dụ thực tế do AI tạo
  lastMistakeNote String?    // Ghi chú lỗi sai gần nhất
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([nextReviewAt])
}

// Bảng ngữ pháp HSK 2 (3.0)
model GrammarPoint {
  id              String    @id @default(uuid())
  level           String    @default("HSK2")
  unitNumber      Int       @default(1)
  orderIndex      Int       @default(1)
  title           String    @unique
  pattern         String
  explanation     String
  examples        Json      // Array<{ chinese: string; pinyin: string; vietnamese: string }>
  commonMistakes  String?
  status          String    @default("new") // new | learning | mastered
  practiceCount   Int       @default(0)
  lastPracticedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Cấu hình lộ trình học cá nhân (1-2 tiếng/ngày)
model StudyProfile {
  id                 String   @id @default("default")
  dailyMinutesTarget Int      @default(90)
  newWordsPerDay     Int      @default(15)
  reviewWordsPerDay  Int      @default(25)
  grammarPerDay      Int      @default(1)
  preferredModel     String   @default("gemini-2.5-flash")
  currentDayNumber   Int      @default(1)
  updatedAt          DateTime @updatedAt
}

// Nhật ký buổi học hàng ngày & nhận xét tổng kết AI
model StudyLog {
  id                 String   @id @default(uuid())
  date               String   // YYYY-MM-DD
  dayNumber          Int      @default(1)
  minutesSpent       Int      @default(0)
  newWordsLearned    Int      @default(0)
  wordsReviewed      Int      @default(0)
  grammarPracticed   Int      @default(0)
  score              Int?
  aiCoachingFeedback Json?
  createdAt          DateTime @default(now())
}

// Bảng lưu trữ bộ bài tập luyện viết
model PracticeSet {
  id            String     @id @default(uuid())
  title         String     // Tiêu đề bài tập
  description   String?    // Mô tả ngắn nội dung bài tập
  vocabularyIds Json       // Danh sách ID từ vựng được chọn
  difficulty    String     // Độ khó (Beginner, HSK1, HSK2, HSK3)
  questionCount Int        // Số lượng câu hỏi
  createdAt     DateTime   @default(now())
  questions     Question[] // Các câu hỏi thuộc bộ bài tập này
}

// Bảng lưu trữ từng câu hỏi luyện viết
model Question {
  id             String      @id @default(uuid())
  practiceSetId  String      // Mã bộ bài tập
  practiceSet    PracticeSet @relation(fields: [practiceSetId], references: id, onDelete: Cascade)
  vietnamese     String      // Câu tiếng Việt
  chinese        String      // Câu tiếng Trung chuẩn
  pinyin         String      // Pinyin của câu tiếng Trung
  usedVocabulary Json        // Mảng các từ vựng đã sử dụng trong câu
  createdAt      DateTime    @default(now())
}
